// PandaKB Lily58 base config + keymap from yusukegenka-lang/lily58-wireless-view-zmk-config

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    // Activate ADJUST layer (RGB controls) by holding Lower and Raise together

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp ESC           &kp CAPS  &kp F2  &kp F4        &none         &none                               &kp F7       &kp F8   &kp F9       &kp F10  &kp F11    &kp BACKSPACE
&kp TAB           &kp Q     &kp W   &kp E         &kp R         &kp T                               &kp Y        &kp U    &kp I        &kp O    &kp P      &kp EXCLAMATION
&kp LEFT_SHIFT    &kp A     &kp S   &kp D         &kp F         &kp G                               &kp H        &kp J    &kp K        &kp L    &kp MINUS  &kp ENTER
&kp LEFT_CONTROL  &kp Z     &kp X   &kp C         &kp V         &kp B        &kp LBKT     &kp RBKT  &kp N        &kp M    &kp COMMA    &kp DOT  &kp FSLH   &kp QUESTION
                                    &kp LEFT_GUI  &kp LEFT_ALT  &lt 1 SPACE  &kp SPACE    &kp RET   &lt 2 SPACE  &kp DEL  &kp AT_SIGN
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        lower_layer {
            display-name = "Lower";
            bindings = <
&none   &none           &none             &none           &none              &none                                   &kp SLASH        &trans           &trans           &trans           &trans         &trans
&none   &kp LEFT_BRACE  &kp LEFT_BRACKET  &kp UP_ARROW    &kp RIGHT_BRACKET  &kp RIGHT_BRACE                         &kp ASTERISK     &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &none          &none
&none   &none           &kp LEFT_ARROW    &kp DOWN_ARROW  &kp RIGHT          &kp PRCNT                               &kp MINUS        &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp RS(CARET)  &trans
&trans  &trans          &none             &kp LESS_THAN   &kp GREATER_THAN   &trans           &trans    &trans       &kp PLUS         &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &none          &none
                                          &trans          &trans             &trans           &trans    &kp PERCENT  &kp KP_NUMBER_0  &kp PERIOD       &kp EQUAL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        raise_layer {
            display-name = "Raise";
            bindings = <
&bt BT_SEL 0  &bt BT_DISC 0  &bt BT_CLR  &trans      &trans         &trans                    &trans  &trans                &trans         &trans                 &trans             &trans
&bt BT_SEL 1  &bt BT_DISC 1  &none       &kp DOLLAR  &kp INT_YEN    &none                     &none   &kp LEFT_PARENTHESIS  &kp UP_ARROW   &kp RIGHT_PARENTHESIS  &none              &none
&bt BT_SEL 2  &bt BT_DISC 2  &none       &kp HASH    &kp AMPERSAND  &none                     &none   &kp LEFT              &kp DOWN       &kp RIGHT_ARROW        &kp TILDE          &trans
&bt BT_SEL 3  &bt BT_DISC 3  &none       &none       &kp CARET      &none   &trans    &trans  &none   &kp SQT               &kp SEMICOLON  &kp COLON              &kp DOUBLE_QUOTES  &kp BSLH
                                         &trans      &trans         &trans  &trans    &trans  &trans  &trans                &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        adjust_layer {
            // From PandaKB default: RGB underglow controls (hold Lower + Raise)
            // ----------------------------------------------------------------------------------------------------------------------------
            // |        |         |         |         |         |         |                  |      |      |       |      |       |       |
            // | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |RGB_TOG|      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            display-name = "Adjust";
            bindings = <
&trans             &trans           &trans           &trans           &trans           &trans                                              &trans  &trans  &trans  &trans  &trans  &trans
&ext_power EP_TOG  &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &rgb_ug RGB_EFF                                     &trans  &trans  &trans  &trans  &trans  &trans
&trans             &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &trans           &trans           &trans                                              &trans  &trans  &trans  &trans  &trans  &trans
&trans             &trans           &trans           &trans           &trans           &trans           &rgb_ug RGB_TOG  &rgb_ug RGB_TOG  &trans  &trans  &trans  &trans  &trans  &trans
                                                     &trans           &trans           &trans           &trans           &trans           &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        extra1 { status = "reserved"; };

        extra2 { status = "reserved"; };

        extra3 { status = "reserved"; };

        extra4 { status = "reserved"; };
    };
};
